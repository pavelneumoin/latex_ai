// РабочийЛист.ai — основная схема БД
// SQLite для dev и MVP. Перед v1.0 — миграция на PostgreSQL (Yandex Managed).
// Утром: при необходимости поменять provider на "postgresql" и DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── AUTH (NextAuth-совместимая часть) ───────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?

  // Профиль учителя
  school        String?
  subjects      String?   // CSV "math,informatics"
  grades        String?   // CSV "5,6,9,11"
  logoPath      String?
  watermark     String?
  accentColor   String?

  role          String    @default("user") // user | moderator | admin
  status        String    @default("active") // active | pending | banned

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  worksheets    Worksheet[]
  uploads       Upload[]
  publications  Publication[]
  subscriptions Subscription[]
  payments      Payment[]
  credits       Credit[]
  favorites     Favorite[]
  purchases     Purchase[]
  classes       Class[]
  checkJobs     CheckJob[]
  reports       Report[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────── WORKSHEETS ───────────────────────────────

model Template {
  id          String  @id           // "T1" .. "T15" и далее
  name        String
  description String?
  subject     String                 // math | informatics | mixed
  grade       Int?
  layout      String                 // single_column | two_columns | grid_2x4 | ...
  style       String                 // minimal_gray | newspaper | ...
  taskCount   Int                    // ориентировочно
  tags        String                 // CSV
  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  worksheets  Worksheet[]
}

model Worksheet {
  id            String   @id @default(cuid())
  userId        String?                       // null = анонимная сессия
  templateId    String
  title         String
  topic         String?
  subject       String?
  grade         Int?
  status        String   @default("draft")    // draft | generating | ready | failed
  variant       String   @default("A")        // A | B | C | ... (для доп-вариантов)
  difficulty    String   @default("medium")   // easy | medium | hard
  parentId      String?                       // для усложнённых/доп-вариантов
  promptUsed    String?                       // ключ промпта (generate_from_topic | generate_from_material | ...)
  llmProvider   String?                       // mock | gigachat | claude | deepseek | openai
  llmModel      String?

  // Исходные параметры генерации (JSON)
  paramsJson    String?

  // Сгенерированный контент (JSON: title, subtitle, tasks: [{n, condition, expected, ...}])
  contentJson   String?

  // Артефакты
  pdfPath       String?
  answerKeyPath String?

  // Публикация
  isPublic      Boolean  @default(false)
  publishedAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  template      Template  @relation(fields: [templateId], references: [id])
  parent        Worksheet?  @relation("WorksheetVariants", fields: [parentId], references: [id], onDelete: SetNull)
  children      Worksheet[] @relation("WorksheetVariants")
  uploads       Upload[]
  publication   Publication?
  favorites     Favorite[]

  @@index([userId, createdAt])
  @@index([isPublic, createdAt])
}

model Upload {
  id          String   @id @default(cuid())
  userId      String?
  worksheetId String?
  checkJobId  String?
  filename    String
  mimeType    String
  size        Int
  path        String                    // относительно storage root
  purpose     String                    // material | photo | logo | check_photo
  extractedText String?                 // OCR / pdf extract результат

  createdAt   DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  worksheet Worksheet? @relation(fields: [worksheetId], references: [id], onDelete: SetNull)
  checkJob  CheckJob?  @relation(fields: [checkJobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([checkJobId])
}

// ─────────────────────────────── МАРКЕТПЛЕЙС ───────────────────────────────

model Publication {
  id            String   @id @default(cuid())
  worksheetId   String   @unique
  userId        String                          // автор
  title         String
  description   String?
  tags          String                          // CSV
  price         Int      @default(0)            // в копейках; 0 = бесплатно
  downloads     Int      @default(0)
  rating        Float    @default(0)
  ratingCount   Int      @default(0)
  isFeatured    Boolean  @default(false)        // отбор «лучших» вручную или авто
  isBestlist    Boolean  @default(false)        // попало во внутреннюю базу лучших

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  worksheet     Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id])
  favorites     Favorite[]

  @@index([isFeatured, downloads])
  @@index([isBestlist])
}

model Favorite {
  id            String   @id @default(cuid())
  userId        String
  worksheetId   String?
  publicationId String?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  worksheet   Worksheet?   @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  publication Publication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([userId, worksheetId])
  @@unique([userId, publicationId])
}

// ─────────────────────────────── БИЛЛИНГ ───────────────────────────────

model Plan {
  id              String   @id                     // "free" | "math" | "informatics" | "all"
  name            String
  description     String?
  subject         String   @default("all")         // math | informatics | all
  tier            String   @default("basic")       // basic (PDF) | source (PDF + исходники)
  priceMonthly    Int                              // копейки
  priceYearly     Int      @default(0)             // копейки; 0 = годового нет
  worksheetsLimit Int                              // -1 = безлимит
  variantsLimit   Int                              // -1 = безлимит
  checksLimit     Int                              // -1 = безлимит
  marketplaceCommissionPct Int @default(20)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   Subscription[]
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String
  planId       String
  subject      String   @default("all")           // math | informatics | all — дублирует plan.subject для уникальности
  status       String   @default("active")        // active | past_due | cancelled
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean @default(false)

  // Лимиты текущего периода
  usedWorksheets Int @default(0)
  usedVariants   Int @default(0)
  usedChecks     Int @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan @relation(fields: [planId], references: [id])

  @@unique([userId, subject])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  amount          Int                              // копейки
  currency        String   @default("RUB")
  status          String                           // pending | succeeded | failed | cancelled
  provider        String                           // yookassa | qiwi | tinkoff | mock
  providerPaymentId String?                        // id у платёжной системы
  purpose         String                           // subscription | credits | one_time
  metadata        String?                          // JSON

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([providerPaymentId])
}

model Credit {
  id        String   @id @default(cuid())
  userId    String
  amount    Int                                    // штук «генераций» или копейки — определяется balance kind
  kind      String                                 // worksheets | tokens | rubles
  reason    String                                 // bonus | purchase | usage | refund
  refId     String?                                // payment.id / worksheet.id
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────── КАТАЛОГ ГОТОВЫХ МАТЕРИАЛОВ (v2) ───────────────────────────────
// Материалы фабрики (Marp-презентации, LaTeX-листы): продаются поштучно и открываются подпиской.

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique                      // "prob45-l1-classic"
  title       String
  description String?
  subject     String                               // math | informatics
  course      String?                              // «Вероятность. Задания 4–5»
  courseSlug  String?                              // prob45 | kurs7 | kurs2 | kurs16 ...
  lessonNo    Int?
  audience    String?                              // «10–11 класс · ЕГЭ»
  kind        String  @default("lesson_kit")       // lesson_kit | presentation | worksheet | test | course_bundle
  priceBasic  Int     @default(4900)               // копейки, уровень PDF
  priceSource Int?                                 // копейки, уровень PDF+исходники; null = не продаётся
  isFree      Boolean @default(false)
  isPublished Boolean @default(true)
  previewPath String?                              // PNG первой страницы (относительно storage)
  pages       Int?
  checkable   Boolean @default(false)              // есть ключ — можно автопроверять
  answerKeyJson String?                            // мастер-ключ: [{n, answer, points}]
  checkInstructions String?                        // инструкция для LLM-проверки этого листа
  downloads   Int     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets      ProductAsset[]
  purchases   Purchase[]
  checkJobs   CheckJob[]

  @@index([subject, isPublished])
  @@index([courseSlug, lessonNo])
}

model ProductAsset {
  id        String  @id @default(cuid())
  productId String
  kind      String                                 // presentation_pdf | worksheet_pdf | cheatsheet_pdf | homework_pdf | test_pdf | answers_pdf | marp_src | tex_src | zip
  tier      String  @default("basic")              // basic | source
  label     String                                 // «Презентация (54 слайда)»
  path      String                                 // относительно storage root
  size      Int?
  pages     Int?
  sortKey   Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, tier])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  productId String
  tier      String   @default("basic")             // basic | source (source включает basic)
  pricePaid Int      @default(0)                   // копейки
  paymentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

// ─────────────────────────────── КЛАССЫ И ПРОВЕРКА (v2) ───────────────────────────────

model Class {
  id         String  @id @default(cuid())
  userId     String
  name       String                                // «7А»
  subject    String  @default("math")              // math | informatics
  gradeLevel Int?                                  // 5..11
  archived   Boolean @default(false)
  // Пороги отметок в процентах (настраиваются на класс)
  scale5     Int     @default(85)
  scale4     Int     @default(65)
  scale3     Int     @default(40)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students   Student[]
  checkJobs  CheckJob[]

  @@index([userId, archived])
}

model Student {
  id        String  @id @default(cuid())
  classId   String
  name      String
  sortKey   Int     @default(0)

  createdAt DateTime @default(now())

  class     Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  results   CheckResult[]

  @@index([classId, sortKey])
}

model CheckJob {
  id         String  @id @default(cuid())
  userId     String
  classId    String?
  productId  String?                               // проверяемый лист из каталога
  title      String
  status     String  @default("draft")             // draft | uploaded | processing | review | done | failed
  totalTasks Int?                                  // число заданий в листе
  maxScore   Int?                                  // максимум баллов
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class      Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  uploads    Upload[]
  results    CheckResult[]
  reports    Report[]

  @@index([userId, createdAt])
}

model CheckResult {
  id          String  @id @default(cuid())
  jobId       String
  studentId   String?
  studentName String                               // имя на момент проверки (или ручной ввод без класса)
  answersJson String  @default("[]")               // [{n, given, expected, ok, points, maxPoints}]
  score       Int     @default(0)
  maxScore    Int     @default(0)
  pct         Float   @default(0)
  mark        Int?                                 // 5 | 4 | 3 | 2
  needsReview Boolean @default(true)               // требует ручной проверки (пока нет LLM)
  absent      Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job         CheckJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([jobId])
}

// ─────────────────────────────── ОТЧЁТЫ (LaTeX → PDF) ───────────────────────────────

model Report {
  id        String  @id @default(cuid())
  userId    String
  kind      String                                 // check | class_period | student
  jobId     String?
  title     String
  status    String  @default("ready")              // generating | ready | failed
  texPath   String?                                // .tex в storage
  pdfPath   String?                                // скомпилированный PDF (если xelatex доступен)

  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       CheckJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
